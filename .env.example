# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Baileys
SESSION_DIR=./auth_info
LOG_LEVEL=info
PRINT_QR_IN_TERMINAL=true

# Anti-ban (broadcast + single send)
ANTI_BAN_ENABLED=true
ANTI_BAN_MIN_DELAY_MS=15000
ANTI_BAN_MAX_DELAY_MS=45000
ANTI_BAN_JITTER_FACTOR=0.4
ANTI_BAN_BATCH_SIZE=20
ANTI_BAN_BATCH_PAUSE_MS=90000
ANTI_BAN_MAX_PER_HOUR=50
ANTI_BAN_MAX_PER_HOUR=50
ANTI_BAN_MAX_PER_DAY=250
ANTI_BAN_DEDUPE_WINDOW_MS=86400000
ANTI_BAN_SKIP_IF_MESSAGED_WITHIN_MS=120000
ANTI_BAN_ACTIVE_HOURS_START=0
ANTI_BAN_ACTIVE_HOURS_END=24
ANTI_BAN_MAX_SEND_RETRIES=3
ANTI_BAN_CONNECTION_WAIT_TIMEOUT_MS=30000

# Inbound message logging
INBOX_ENABLED=true
INBOX_LOG_DIR=./inbox_logs
INBOX_INCLUDE_STATUS=false

# AI / Postgres (cycle: be-ai-auto-reply-2026-07-03)
DATABASE_URL=postgres://baileys:baileys@localhost:5432/baileys
DEFAULT_TENANT_ID=default

# MiniMax-M3 (OpenAI-compatible)
LLM_PROVIDER=openai-compatible
OPENAI_API_KEY=sk-replace-with-minimax-key
OPENAI_BASE_URL=https://api.MiniMax.com/v1
LLM_MODEL=MiniMax-M3
LLM_MAX_RETRIES=2

# Anthropic-compatible fallback (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# Embeddings (MiniMax)
EMBEDDING_MODEL=MiniMax-embed
EMBEDDING_DIM=1536

# Audit + KB directories (optional overrides)
AUDIT_DIR=./data/audit
KB_DIR=./data/kb

# Smoke test gate
RUN_SMOKE=0